# Copy this file to .env and fill in your Upstox Developer App values.
# Never commit .env. An access token normally expires at 03:30 IST the next day.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional calendar-day override for the timeframe-specific lookback default.
# Leave blank to use each timeframe's documented default history depth.
UPSTOX_LOOKBACK_DAYS=
# Used by: python screener.py --test
UPSTOX_TEST_SYMBOL_LIMIT=5
# Optional JSON object with non-standard NSE session closes, e.g.
# {"2026-11-08": {"close": "13:00"}}
UPSTOX_SESSION_OVERRIDES_JSON=
